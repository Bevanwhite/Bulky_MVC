@model Product
@{
    Layout = "_CardLayout";
    ViewBag.CardTitle = "Create Product";
}

<input-group asp-for="Title" layout="floating"/>
<input-group asp-for="Description" layout="floating"/>
<input-group asp-for="ISBN" layout="floating"/>
<input-group asp-for="Author" layout="floating"/>
<input-group asp-for="ISBN" layout="floating"/>
<input-group asp-for="ListPrice" layout="floating"/>
<input-group asp-for="Price" layout="floating"/>
<input-group asp-for="Price50" layout="floating"/>
<input-group asp-for="Price100" layout="floating"/>
<form-actions submit-text="Create" row-css="mt-3" submit-button-class="btn-outline-secondary"
    area="Admin" controller="Product" />
