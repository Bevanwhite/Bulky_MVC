@model Category
@{
    Layout = "_CardLayout";
    ViewBag.CardTitle = "Create Category";
}
<input-group asp-for="Name" layout="floating" />
<input-group asp-for="DisplayOrder" layout="floating" />
<form-actions submit-text="Create" row-css="mt-3" area="Admin" 
back-button-class="btn-outline-secondary" controller="Category" />